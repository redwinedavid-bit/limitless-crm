# Copy values into a cloud host's secure environment configuration. Not a credential file.
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/limitless_staging
APP_PUBLIC_URL=https://crm-staging.example.com
ALLOWED_HOSTS=crm-staging.example.com
COOKIE_SECURE=1
# Leave Gmail unconfigured until OAuth setup.
# In container-only hosting, uploads MUST stay disabled until private durable storage exists.
LMS_DURABLE_UPLOADS=0
